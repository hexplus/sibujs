# Node.js
node_modules/
# package-lock.json is COMMITTED on purpose. A library's lockfile does not
# affect consumers' dependency resolution, but it makes this repository's own
# certification reproducible: without it, CI silently re-resolves transitive
# dev dependencies on every run and cannot use `npm ci`. See LOCK-001.
.npm/

# Build output
dist/
*.log

# Editor/IDE
.vscode/
.idea/

# Tests
coverage/
*.test.ts.snap

# OS
.DS_Store
Thumbs.db

# Optional: vitest cache
vitest-cache/

# Temporary files
*.tmp
*.swp
notes.txt
